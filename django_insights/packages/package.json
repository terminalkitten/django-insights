{
  "name": "@django-insights/dashboard",
  "private": true,
  "description": "Builds the dashboard stylesheet",
  "scripts": {
    "vendor": "cp node_modules/basecoat-css/dist/js/basecoat.min.js node_modules/basecoat-css/dist/js/sidebar.min.js ../static/insights/js/",
    "build": "pnpm run vendor && tailwindcss -i src/input.css -o ../static/insights/css/insights.css --minify",
    "dev": "tailwindcss -i src/input.css -o ../static/insights/css/insights.css --watch"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.0.2",
    "tailwindcss": "^4.3.3"
  }
}
